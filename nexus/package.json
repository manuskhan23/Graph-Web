{
  "name": "nexus-ai",
  "version": "2.0.0",
  "private": true,
  "description": "NEXUS AI \u2014 autonomous AI desktop engineering agent",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "build:server": "tsc -p packages/server/tsconfig.json",
    "build:ui": "vite build --config ui/vite.config.ts",
    "build": "npm run build:server && npm run build:ui",
    "start": "node dist/server/src/main.js",
    "dev": "node dist/server/src/main.js",
    "dev:ui": "vite --config ui/vite.config.ts",
    "typecheck": "tsc -p packages/server/tsconfig.json --noEmit && tsc -p packages/desktop/tsconfig.json --noEmit && tsc -p ui/tsconfig.json",
    "test": "node --experimental-sqlite --test dist/core/test/*.test.js",
    "test:build": "tsc -p packages/core/tsconfig.json && npm test",
    "desktop": "electron dist/desktop/main.js"
  },
  "dependencies": {
    "chokidar": "^4.0.3",
    "diff": "^8.0.2",
    "express": "^4.21.2",
    "playwright": "^1.55.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/diff": "^7.0.2",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "^33.4.11",
    "jsdom": "^31.0.0",
    "typescript": "^5.7.3",
    "vite": "^7.2.4"
  }
}
